<?xml version="1.0" encoding="utf-8"?>
<!-- Widgeten er ét billede. Hele panelet tegnes på et Canvas i
     WidgetRenderer, fordi RemoteViews ikke kan indeholde en WebView
     og kun understøtter et snævert udvalg af komponenter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

</FrameLayout>
